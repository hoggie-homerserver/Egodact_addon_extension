{
  "manifest_version": 3,
  "name": "Egodact Pantagora",
  "version": "1.1",
  "description": "Extension to add some useful features to the Egodact platform.",
  "content_scripts": [
    {
      "matches": [
        "https://app.egodact.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "host_permissions": [
    "https://api.egodact.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "test-page.html"
      ],
      "matches": [
        "https://app.egodact.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "egodact-pantagora@maxitaxi",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
