{
  "manifest_version": 3,
  "name": "Egodact Pantagora Dev Build",
  "version": "2.0",
  "description": "Development build of the Egodact Pantagora extension for testing purposes.",
  "content_scripts": [
    {
      "matches": [
        "https://app.egodact.com/*"
      ],
      "js": [
        "src/config.js",
        "src/security.js",
        "src/theme.js",
        "src/menus/smart-menu.js",
        "src/menus/beta-menu.js",
        "src/menus/games-menu.js",
        "src/menus/tijd.js",
        "src/games/snake.js",
        "src/games/flappy.js",
        "src/games/tetris.js",
        "src/games/minesweeper.js",
        "src/games/2048.js",
        "src/challenges.js",
        "src/tasks.js",
        "src/weekplanning.js",
        "src/buttons.js",
        "src/main.js"
      ]
    }
  ],
  "host_permissions": [
    "https://api.egodact.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "test-page.html"
      ],
      "matches": [
        "https://app.egodact.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "egodact-pantagora@maxitaxi",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
